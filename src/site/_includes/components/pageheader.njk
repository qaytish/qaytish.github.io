<style>
.lang-switcher {
  position: fixed;
  bottom: 16px;
  right: 24px;
  z-index: 9999;
  display: flex;
  gap: 10px;
  background: rgba(255,255,255,0.94);
  backdrop-filter: blur(16px);
  padding: 8px 14px;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  font: 600 14px system-ui;
}
.lang-switcher button {
  all: unset;
  padding: 6px 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  color: rgba(30, 30, 30, 0.94) !important;
  background-color: white !important;
  font-weight: bold
}
.lang-switcher button.active {
  color: white !important;
  background: #0066ff !important;
  color: white;
}
.lang-switcher button:hover:not(.active) {
  background: #f0f0f0;
}
@media (prefers-color-scheme: dark) {
  .lang-switcher { background: rgba(30,30,30,0.94); }
  .lang-switcher button:hover:not(.active) { background: #404040; }
}
</style>



<script>
document.addEventListener("DOMContentLoaded", () => {
  // ---------------------------------------------------------
  // Utility: extract slug from href (no trailing slash)
  // ---------------------------------------------------------
  const getSlugFromHref = (href) => {
    try {
      const url = new URL(href, location.origin);
      const clean = url.pathname.replace(/\/+$/, "");
      const parts = clean.split("/").filter(Boolean);
      return parts.length ? parts.pop() : "";
    } catch {
      return "";
    }
  };

  const hasLangSuffix = (slug) => /-([a-z]{2,3})$/i.test(slug);
  const getLangSuffix = (slug) => slug.match(/-([a-z]{2,3})$/i)?.[1]?.toLowerCase() || null;
  const stripLangSuffix = (slug) => slug.replace(/-([a-z]{2,3})$/i, "");

  // ---------------------------------------------------------
  // STEP 1: Collect slugs from sidebar
  // ---------------------------------------------------------
  const anchors = [...document.querySelectorAll("a.filename")];
  const slugs = anchors
    .map(a => a.getAttribute("href"))
    .filter(href => href && href !== "/")
    .map(getSlugFromHref)
    .filter(Boolean);

  // ---------------------------------------------------------
  // STEP 2: Infer languages by repeated suffixes
  // ---------------------------------------------------------
  const langCounts = {};
  for (const slug of slugs) {
    const lang = getLangSuffix(slug);
    if (lang) langCounts[lang] = (langCounts[lang] || 0) + 1;
  }

  const LANGS = Object.keys(langCounts)
    .filter(lang => langCounts[lang] > 1)  // avoid accidental singletons
    .sort()
    .reduce((acc, lang) => {
      acc[lang] = lang.toUpperCase();
      return acc;
    }, {});

  const langList = Object.keys(LANGS);
  if (langList.length === 0) return;

  // ---------------------------------------------------------
  // STEP 3: Detect whether site uses unsuffixed "default" pages
  // If any sidebar slug has NO suffix, we assume default pages are unsuffixed.
  // ---------------------------------------------------------
  const hasUnsuffixedPages = slugs.some(s => !hasLangSuffix(s));

  // Pick a stable default:
  // - If unsuffixed pages exist, default language is "unsuffixed".
  //   We still need a code for button highlighting. We’ll choose:
  //   1) current page's lang if it has suffix
  //   2) otherwise first detected language (only for UI label fallback)
  // - If all pages are suffixed, default is just the first detected language.
  const rawPath = location.pathname.replace(/\/+$/, "") || "/";
  const parts = rawPath.split("/").filter(Boolean);
  const slug = parts.length ? parts[parts.length - 1] : "";
  const baseDir = parts.length > 1 ? "/" + parts.slice(0, -1).join("/") + "/" : "/";
  const currentLang = getLangSuffix(slug) || (langList[0] || "");
  const baseName = stripLangSuffix(slug);

  const DEFAULT_LANG = hasUnsuffixedPages ? "__default__" : langList[0];

  // Helper: is this target language considered the default?
  const isDefaultLang = (langCode) => (
    DEFAULT_LANG === "__default__" ? langCode === (langList[0] || langCode) : langCode === DEFAULT_LANG
  );

  // ---------------------------------------------------------
  // STEP 4: Detect home base name from sidebar link (fallback: "home")
  // ---------------------------------------------------------
  const getHomeBaseName = () => {
    const link =
      document.querySelector('a.filename[href="/"], a.filename[href="./"], a[href="/"].filename') ||
      document.querySelector('a[href="/"], a[href="./"]');

    if (!link?.textContent) return "home";

    return link.textContent
      .trim()
      .toLowerCase()
      .replace(/\s+/g, "-")
      .replace(/[^\w-]/g, "")
      .replace(/-([a-z]{2,3})$/i, "");
  };

  const homeBase = getHomeBaseName();

  // ---------------------------------------------------------
  // STEP 5: Build target URLs (omit suffix for default when applicable)
  // ---------------------------------------------------------
  const buildTargetUrl = (targetLang) => {
    const isRoot = rawPath === "/";
    const isHomePage = baseName === homeBase || slug === "" || slug === homeBase || slug === (homeBase + "-" + currentLang);

    // If site uses unsuffixed default pages:
    const omitSuffix = hasUnsuffixedPages && isDefaultLang(targetLang);

    if (isRoot || isHomePage) {
      if (omitSuffix) return "/";
      return "/" + homeBase + "-" + targetLang;
    }

    if (omitSuffix) {
      return baseDir + baseName;
    }
    return baseDir + baseName + "-" + targetLang;
  };

  // ---------------------------------------------------------
  // STEP 6: Create language switcher
  // ---------------------------------------------------------
  const switcher = document.createElement("div");
  switcher.className = "lang-switcher";

  for (const [code, label] of Object.entries(LANGS)) {
    const btn = document.createElement("button");
    btn.textContent = label;

    // Active state:
    // - If current page has a suffix, match it.
    // - If current page is unsuffixed, mark the "default" button active (we map it to first detected lang).
    const currentIsUnsuffixed = !hasLangSuffix(slug);
    const defaultUiCode = langList[0]; // just for UI highlight, since "unsuffixed" isn't a real code

    if ((!currentIsUnsuffixed && code === currentLang) || (currentIsUnsuffixed && code === defaultUiCode)) {
      btn.classList.add("active");
    }

    btn.onclick = async () => {
      const targetUrl = buildTargetUrl(code);
      if (location.pathname.replace(/\/+$/, "") === targetUrl.replace(/\/+$/, "")) return;

      try {
        const res = await fetch(targetUrl, { method: "HEAD" });
        if (res.ok) location.href = targetUrl;
      } catch {
        // If HEAD fails (some hosts block it), fall back to navigation anyway.
        location.href = targetUrl;
      }
    };

    switcher.appendChild(btn);
  }

  document.body.appendChild(switcher);
});
</script>














